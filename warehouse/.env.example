# Copy to warehouse/.env and fill in. Never commit the real .env.
#
#   openssl rand -base64 24     for each password

# Superuser the simulator connects as. Owns every schema.
POSTGRES_DB=warehouse
POSTGRES_USER=sim_writer
POSTGRES_PASSWORD=

# Read-only credentials handed to the products. Clarity's backend gets
# clarity_reader; a second project gets its own. Both are SELECT-only on the
# warehouse — see sql/070_grants.sql.
CLARITY_READER_PASSWORD=
NABD_READER_PASSWORD=

# Published port, as host_ip:host_port:container_port. Keep the host IP on
# loopback in every deployment, including the VPS — application containers
# reach the database over warehouse_net, not through this port, and binding
# 0.0.0.0 would put the warehouse on the public internet.
POSTGRES_PUBLISH=127.0.0.1:5432:5432

# Seed for the generator. Fixed → a rebuild reproduces the same dataset.
SIM_SEED=20260728

# ─── Live ticker ────────────────────────────────────────────────────────────
# How often it wakes, and the arrival rate it targets. The rate is a DAILY
# total spread across the hourly demand curve, so at 2500/day the evening peak
# runs ~280 orders/hour and 04:00 is nearly still.
SIM_TICK_SECONDS=10
SIM_ORDERS_PER_DAY=2500
# Rolling retention. Keeps the database bounded and the dataset never stale;
# 18 months preserves YTD and year-on-year comparisons.
SIM_RETENTION_DAYS=548
