# ─── Gemini API ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
# High-volume chat classification runs on the cheap lite tier (~6x cheaper than flash)
GEMINI_CLASSIFY_MODEL=gemini-3.1-flash-lite
# minimal|low|medium|high — 3.x models default to medium and bill thinking tokens
# as output; medium cost ~12x per classification for no accuracy gain.
GEMINI_THINKING_LEVEL=minimal
GEMINI_CONCURRENCY=5

# ─── Data ─────────────────────────────────────────────────────────────────────
# All analytics read backend/data/clarity.db (SQLite). Build/rebuild it with:
#   python scripts/generate_mock_db.py
# There is no cloud warehouse and no credentials to configure.

# ─── App ──────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=info

# ─── Batch classification ─────────────────────────────────────────────────────
CLASSIFY_BATCH_SIZE=10
CLASSIFY_BATCH_DELAY_S=0.5

# ─── Waitlist notifications ───────────────────────────────────────────────────
# Every "Unlock full version" signup is emailed here. Leave SMTP_HOST or the
# credentials blank and signups are still stored in the warehouse, just silent.
# Google Workspace / Gmail: smtp.gmail.com:587 with an App Password
# (myaccount.google.com → Security → 2-Step Verification → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=t.mutahir@gorafeeq.com
SMTP_PASSWORD=
SMTP_FROM=
WAITLIST_NOTIFY_TO=t.mutahir@gorafeeq.com
