# ─── Gemini API ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_CONCURRENCY=5

# ─── Google Cloud / BigQuery ──────────────────────────────────────────────────
# BigQuery uses Application Default Credentials — run: gcloud auth application-default login
GCP_PROJECT_ID=long-ceiling-343505
BQ_CALLS_DATASET=reports          # Pillar 01: call_analysis, vendor_kpi, vendor_items_kpi
BQ_TEXT_DATASET=reports            # Pillar 02: messages, classifications, labels (same dataset as chat_history)

# ─── App ──────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=info

# ─── Batch classification ─────────────────────────────────────────────────────
CLASSIFY_BATCH_SIZE=10
CLASSIFY_BATCH_DELAY_S=0.5
