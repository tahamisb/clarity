# Copy to .env on the VPS and fill in. Never commit the real .env.
# Full walkthrough in DEPLOY.md.

# Public address. SITE_ADDRESS takes a comma-separated list of hostnames;
# Caddy issues a certificate per name. Use :80 and an http:// PUBLIC_URL to
# run on the bare IP without HTTPS. No trailing slash on PUBLIC_URL.
SITE_ADDRESS=interns26.cloud, www.interns26.cloud
PUBLIC_URL=https://interns26.cloud

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Email domain allowed to sign in. Shown in the login UI, so it is public.
NEXT_PUBLIC_ALLOWED_DOMAIN=example.com

# Shared placeholder password until real Google OAuth is live. The domain check
# is a string match only — it does not verify the address exists — so this
# password is the ONLY thing gating access. Change it from the default.
DEV_LOGIN_PASSWORD=

# Fill in to switch on real Google OAuth; leave blank otherwise.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Warehouse ──────────────────────────────────────────────────────────────
# Only needed when running with the docker-compose.warehouse.yml overlay, which
# points the backend at the simulated live Postgres warehouse instead of the
# baked SQLite snapshot:
#
#   cd warehouse && docker compose up -d          # start the warehouse first
#   docker compose -f docker-compose.yml -f docker-compose.warehouse.yml up -d
#
# Must match CLARITY_READER_PASSWORD in warehouse/.env. See warehouse/README.md.
CLARITY_READER_PASSWORD=
WAREHOUSE_DB=warehouse

# Required for any AI feature. The backend still boots without it — compose
# passes an empty string, which satisfies pydantic — but Gemini calls fail.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_CLASSIFY_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=minimal
GEMINI_CONCURRENCY=5
LOG_LEVEL=info

# Where "Unlock full version" signups are emailed. Leave SMTP_PASSWORD blank and
# signups are still stored in the warehouse — just not emailed to anyone. Verify
# with: curl https://interns26.cloud/api/v1/waitlist/status
# Gmail / Google Workspace needs an App Password, not the account password:
# myaccount.google.com -> Security -> 2-Step Verification -> App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=t.mutahir@gorafeeq.com
SMTP_PASSWORD=
SMTP_FROM=
WAITLIST_NOTIFY_TO=t.mutahir@gorafeeq.com
