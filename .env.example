# Copy to .env on the VPS and fill in. Never commit the real .env.
#
#   cp .env.example .env && nano .env

# ─── Public address ───────────────────────────────────────────────────────────
# With a domain (recommended — Caddy gets you a free cert automatically):
#   SITE_ADDRESS=clarity.example.com
#   PUBLIC_URL=https://clarity.example.com
#
# Bare IP, no domain yet (HTTP only — no cert is possible for an IP):
#   SITE_ADDRESS=:80
#   PUBLIC_URL=http://76.13.188.48
#
# PUBLIC_URL must have NO trailing slash. It is baked into the frontend bundle
# at build time, so changing it requires `docker compose build frontend`.
SITE_ADDRESS=
PUBLIC_URL=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Shown in the login UI; only emails on this domain may sign in.
NEXT_PUBLIC_ALLOWED_DOMAIN=gorafeeq.com

# Shared placeholder password until real Google OAuth is live (see AUTH_SETUP.md).
DEV_LOGIN_PASSWORD=

# Fill these in to switch on real Google OAuth; leave blank otherwise.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Backend ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_CLASSIFY_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=minimal
GEMINI_CONCURRENCY=5
LOG_LEVEL=info
